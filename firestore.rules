rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A user can read ONLY their own profile (it contains their email).
    // Other players' display data (names, avatars) is served by the backend API.
    //
    // Clients may create their own profile document once at registration with a
    // All user profile creation and updates go through verified backend API routes
    // (/api/auth/register-profile and /api/user/profile) to enforce unique usernames
    // and prevent field tampering.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Memberships can only be read by the owner of the membership.
    // Client-side writes are completely disabled; all joins and creations
    // are executed securely via Next.js backend API routes with Firebase Admin.
    match /memberships/{membershipId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Direct client access to leagues and picks is blocked.
    // All operations are handled via verified backend API routes.
    match /leagues/{leagueId} {
      allow read, write: if false;
    }

    match /picks/{pickId} {
      allow read, write: if false;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
